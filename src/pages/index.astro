---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WorkVisual from '../components/WorkVisual.astro';
import portrait from '../assets/portrait.jpg';
import { person, tags, work, pipeline, pipelineStats, aiPrinciple, playground, experience, introVideo } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const firstYear = Math.min(...experience.map((e) => Number(e.years.slice(0, 4))));
const years = new Date().getFullYear() - firstYear;
---

<Base
  title="Taisiia Silkina · Product designer for B2B SaaS & AI"
  description="Taisiia Silkina designs B2B SaaS and AI products: complex roles, statuses and workflows turned into clear interfaces."
>
  <!-- Hero -->
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="tags" aria-hidden="true">
      {tags.map((t) => (
        <span class="tag" data-speed={t.speed} style={`left:${t.x}%;top:${t.y}%;--r:${t.r}deg`}>
          {t.text}
        </span>
      ))}
    </div>
    <p class="hello">
      Hi
      <Image src={portrait} alt="" width={160} height={160} class="hello-face" loading="eager" />
      I’m {person.first}
    </p>
    <h1 id="hero-title" class="display">
      <span class="line"><span>Product designer</span></span>
      <span class="line"><span>for B2B SaaS & AI</span></span>
    </h1>
    <p class="lead hero-sub">
      I turn messy business logic into products people understand: roles, statuses and AI features.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="#work">View work</a>
      <a class="btn btn-quiet" href={person.links.cv}>Download CV</a>
    </div>
  </section>

  <!-- Fan of cards -->
  <section class="fan wrap" aria-label="Where to start">
    <a class="card tone-blue" href="#work" style="--r:-6deg" data-reveal>
      <span class="card-title">In numbers</span>
      <dl class="card-stats">
        <div><dt>years in B2B SaaS & AI</dt><dd>{years}+</dd></div>
        <div><dt>projects across web, mobile, SaaS & AI</dt><dd>40+</dd></div>
      </dl>
      <span class="card-go">Read the cases →</span>
    </a>
    <div class="card card-photo" style="--r:3deg" data-reveal>
      <div class="photo-drift" data-drift>
        {introVideo ? (
          <video src={`${base}/${introVideo}`} autoplay muted loop playsinline aria-label="Taisiia saying hi" />
        ) : (
          <Image
            src={portrait}
            alt="Taisiia in a pink hoodie, lifting pixel-art sunglasses and smiling"
            widths={[360, 540, 720]}
            sizes="(max-width: 760px) 70vw, 280px"
            loading="eager"
          />
        )}
      </div>
    </div>
    <a class="card tone-amber" href="#ai" style="--r:-3deg" data-reveal>
      <span class="card-title">Faster with AI</span>
      <span class="card-big">−40%</span>
      <span class="card-text">UX process and review time with my own Claude skills pipeline.</span>
      <span class="card-go">See my approach →</span>
    </a>
    <a class="card tone-ink" href="#playground" style="--r:5deg" data-reveal>
      <span class="card-title">On the side</span>
      <span class="card-text">Mobile apps, games and drawings I make for fun. One quiz app has 1,000+ downloads.</span>
      <span class="card-go">Go to the playground →</span>
    </a>
  </section>

  <!-- Work -->
  <section id="work" class="section wrap" aria-labelledby="work-title">
    <div class="sec-head" data-reveal>
      <h2 id="work-title" class="h2">Selected work</h2>
      <p class="lead sec-sub">B2B SaaS and AI products, from discovery to developer handoff.</p>
    </div>
    <ol class="timeline">
      {work.map((w, i) => {
        const href = 'slug' in w && w.slug ? `${base}/work/${w.slug}/` : null;
        const Tag = href ? 'a' : 'div';
        return (
          <li class="item" style={`--i:${i}`} data-stack>
            <p class="year" data-reveal>{w.year}</p>
            <Tag class="item-body" href={href ?? undefined}>
              <h3 class="h3" data-reveal>{w.title}</h3>
              <p class="item-text" data-reveal style="--i:1">{w.text}</p>
              <dl class="metrics" data-reveal style="--i:2">
                {w.metrics.map((m) => (
                  <div>
                    <dt>{m.label}</dt>
                    <dd>{m.value}</dd>
                  </div>
                ))}
              </dl>
              <div data-reveal style="--i:3">
                <WorkVisual kind={w.visual} />
              </div>
              <p class="item-go" data-reveal style="--i:4">
                {href ? (
                  <span class="link-arrow">Read the case study <span aria-hidden="true">→</span></span>
                ) : (
                  <span class="soon">Case study in progress</span>
                )}
              </p>
            </Tag>
          </li>
        );
      })}
    </ol>
  </section>

  <!-- AI -->
  <section id="ai" class="ai" aria-labelledby="ai-title">
    <div class="wrap section">
      <div class="ai-head" data-reveal>
        <h2 id="ai-title" class="h2">How I work</h2>
        <p class="lead">
          My approach from brief to delivery. My own Claude skills take the slow parts: AI drafts, I decide.
        </p>
      </div>
      <dl class="ai-stats" data-reveal>
        {pipelineStats.map((st) => (
          <div>
            <dt>{st.label}</dt>
            <dd>{st.value}</dd>
          </div>
        ))}
      </dl>
      <ol class="flow">
        {pipeline.map((p, i) => (
          <li class={`fstep ${i % 2 ? 'fstep-paper' : 'fstep-amber'}`} style={`grid-row:${i + 1};--i:${i};--r:${[-1.2, 1, -0.6, 1.4, -1, 0.8, -0.4][i]}deg`} data-reveal>
            <span class="fshape" aria-hidden="true" style={`--shape:${i % 3}`}></span>
            <h3 class="ftitle">
              <span class="fnum">{i + 1}.</span> {p.stage}
            </h3>
            <p class="fme">{p.me}</p>
            {p.ai && <p class="fai"><span>AI drafts</span> {p.ai}</p>}
            <p class="fout">→ {p.out}</p>
            {i < pipeline.length - 1 && (
              <svg class="farrow" viewBox="0 0 120 90" aria-hidden="true">
                <path d="M8 8 C 30 70, 70 78, 104 62" />
                <path d="M88 50 L 106 62 L 90 76" />
              </svg>
            )}
          </li>
        ))}
      </ol>
      <blockquote class="ai-principle" data-reveal>
        <p class="ai-principle-title">{aiPrinciple.title}</p>
        <p>{aiPrinciple.text}</p>
      </blockquote>
      <p class="ai-link" data-reveal>
        <a class="btn btn-amber" href={person.links.skills}>Read my case-study-writer skill on GitHub</a>
      </p>
    </div>
  </section>

  <!-- Playground -->
  <section id="playground" class="play" aria-labelledby="play-title">
    <div class="canvas" data-canvas tabindex="0" aria-label="Playground canvas, drag or scroll to look around">
      <div class="board">
        <div class="play-center">
          <h2 id="play-title" class="h2">Playground</h2>
          <p class="lead">Side projects and things I make for fun.</p>
        </div>
        <p class="sticky hand" style="left:27%;top:45%">
          my rules for side projects: <br />no client, no brief, <br />just curiosity
        </p>
        {playground.map((p, i) => {
          const Tag = 'href' in p && p.href ? 'a' : 'article';
          return (
            <Tag
              class="pcard"
              href={'href' in p ? p.href : undefined}
              style={`left:${p.x}%;top:${p.y}%;--r:${p.r}deg`}
            >
              <div class={`pcover tone-${p.tone}`}>
                <h3 class="ptitle">{p.title}</h3>
              </div>
              <p class="ptext">{p.text}</p>
            </Tag>
          );
        })}
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="section wrap about" aria-labelledby="about-title">
    <div class="about-photo" data-reveal>
      <Image src={portrait} alt="Portrait of Taisiia Silkina" widths={[420, 640, 840]} sizes="(max-width: 760px) 90vw, 420px" />
    </div>
    <div class="about-text">
      <h2 id="about-title" class="h2" data-reveal>About me</h2>
      <p class="lead" data-reveal style="--i:1">
        I’m a product designer from Dnipro, Ukraine, with 4+ years and 40+ projects across web, mobile, B2B SaaS and AI. I
        like the messy part: interviews, role matrices, status maps. At ANODA I led client projects end to end and covered for
        the Design Lead, coordinating up to three designers.
      </p>
      <p data-reveal style="--i:2">
        Outside client work I build small apps, draw and write Claude skills. I’m looking for a remote role in a B2B SaaS or AI
        product team.
      </p>
      <h3 class="h3 exp-title" data-reveal style="--i:3">Experience</h3>
      <ul class="exp" data-reveal style="--i:4">
        {experience.map((e) => (
          <li>
            <span class="exp-years">{e.years}</span>
            <span class="exp-company">{e.company}</span>
            <span class="exp-role">{e.role}</span>
          </li>
        ))}
      </ul>
      <p class="facts small" data-reveal style="--i:5">
        Domains: B2B SaaS · AI products · FinTech · Healthcare · E-commerce · English B2
      </p>
      <p class="about-cta" data-reveal style="--i:6">
        <a class="btn btn-primary" href={person.links.cv}>Open my full CV <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding-top: clamp(72px, 9vw, 140px);
    padding-bottom: clamp(96px, 10vw, 160px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .tags {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .hero > :not(.tags) {
    position: relative;
    z-index: 1;
  }
  .tag {
    position: absolute;
    transform: translate(var(--px, 0px), var(--py, 0px)) rotate(var(--r));
    padding: 10px 20px;
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    font-weight: 600;
    font-size: clamp(0.9rem, 0.82rem + 0.3vw, 1.1rem);
    white-space: nowrap;
    user-select: none;
    will-change: transform;
    animation: fade 0.8s 0.5s var(--ease) both;
  }
  .hello {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.22em;
    font-size: var(--step-display);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.05em;
    margin: 0 0 0.12em;
    animation: fade 0.8s var(--ease) both;
  }
  .hello :global(.hello-face) {
    width: 0.82em;
    height: 0.82em;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .display {
    font-size: var(--step-display);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.05em;
    margin: 0;
  }
  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }
  .line > span {
    display: block;
    animation: rise 0.9s var(--ease) both;
  }
  .line:nth-child(2) > span {
    animation-delay: 0.11s;
  }
  @keyframes rise {
    from {
      transform: translateY(105%);
    }
  }
  .hero-sub {
    max-width: 46ch;
    margin: 32px 0 0;
    animation: fade 0.8s 0.35s var(--ease) both;
  }
  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 32px;
    animation: fade 0.8s 0.45s var(--ease) both;
  }
  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  /* Fan */
  .fan {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding-bottom: calc(var(--gap-section) / 2);
  }
  .card {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    padding: clamp(20px, 2vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-decoration: none;
    rotate: var(--r);
    margin-inline: -12px;
    transition:
      rotate 0.4s var(--ease),
      translate 0.4s var(--ease);
  }
  .card:hover,
  .card:focus-visible {
    rotate: 0deg;
    translate: 0 -10px;
    z-index: 2;
  }
  .card-title {
    font-size: var(--step-lead);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .card-text {
    font-size: var(--step-body);
    line-height: 1.4;
  }
  .card-go {
    margin-top: auto;
    font-weight: 600;
  }
  .card-photo {
    padding: 0;
    overflow: hidden;
    position: relative;
  }
  .photo-drift {
    height: 112%;
    margin-top: -6%;
    transform: translateY(var(--drift, 0));
  }
  .card-stats {
    display: grid;
    gap: 14px;
    margin: 8px 0 0;
  }
  .card-stats div {
    display: flex;
    flex-direction: column-reverse;
  }
  .card-stats dd,
  .card-big {
    margin: 0;
    font-size: clamp(2.25rem, 1.4rem + 2.6vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 0.95;
  }
  .card-stats dt {
    font-size: var(--step-small);
    font-weight: 600;
    line-height: 1.3;
  }
  .card-photo :global(img),
  .card-photo video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  /* Work */
  .sec-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: end;
    margin-bottom: clamp(48px, 6vw, 96px);
  }
  .sec-sub {
    margin: 0;
    max-width: 36ch;
    justify-self: end;
  }
  /* Work cards stack: each card sticks under the header and the next one slides over it. */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(32px, 4vw, 56px);
  }
  .item {
    position: sticky;
    top: calc(96px + var(--i) * 18px);
    display: grid;
    grid-template-columns: minmax(120px, 2fr) 10fr;
    gap: 24px;
    padding: clamp(24px, 3vw, 48px);
    background: var(--surface);
    border-radius: calc(var(--radius) + 8px);
    transform-origin: 50% 0;
    scale: var(--s, 1);
    filter: brightness(var(--b, 1));
    box-shadow: 0 -12px 40px rgb(14 12 21 / 0.06); /* taste-skill-ignore: edge of the card sliding over */
  }
  .year {
    margin: 0;
    font-size: var(--step-lead);
    font-weight: 800;
    color: var(--muted);
  }
  .item-body {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 20px 48px;
    text-decoration: none;
    align-items: start;
  }
  .item-body > .h3 {
    grid-column: 1 / -1;
    font-size: var(--step-head);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .item-text {
    margin: 0;
    max-width: 44ch;
  }
  .metrics {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 24px 40px;
    grid-column: 1;
  }
  .metrics div {
    display: flex;
    flex-direction: column-reverse;
  }
  .metrics dd {
    margin: 0;
    font-size: var(--step-head);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--accent);
  }
  .metrics dt {
    font-size: var(--step-small);
    color: var(--muted);
    max-width: 18ch;
    margin-top: 6px;
  }
  .item-body > div:has(.vis) {
    grid-column: 2;
    grid-row: 2 / span 3;
  }
  .item-go {
    margin: 0;
    grid-column: 1;
  }
  .soon {
    color: var(--muted);
    font-weight: 600;
  }

  /* AI */
  .ai {
    background: var(--ink);
    color: var(--bg);
  }
  .ai-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px 48px;
    align-items: end;
    margin-bottom: clamp(48px, 6vw, 88px);
  }
  .ai-head .lead {
    margin: 0;
    max-width: 40ch;
  }
  .ai-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px 48px;
    margin: 0 0 clamp(48px, 6vw, 80px);
    padding-top: 28px;
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }
  .ai-stats div {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ai-stats dd {
    order: -1;
  }
  .ai-stats dd {
    margin: 0;
    font-size: var(--step-head);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--amber);
  }
  .ai-stats dt {
    color: #d8d6e0;
    font-size: var(--step-small);
    max-width: 26ch;
  }

  /* Approach flow: torn-paper blocks zigzag down the page, joined by hand-drawn arrows. */
  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
  }
  .fstep {
    position: relative;
    grid-column: 1 / span 6;
    padding: clamp(28px, 3.2vw, 52px) clamp(28px, 3.6vw, 60px) clamp(32px, 3.6vw, 56px);
    rotate: var(--r);
    color: var(--ink);
  }
  .fstep:nth-child(even) {
    grid-column: 7 / span 6;
  }
  .fstep + .fstep {
    margin-top: clamp(-120px, -7vw, -60px);
  }
  .fshape {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--amber);
    clip-path: polygon(0% 6%, 22% 0%, 64% 3%, 100% 0%, 98% 46%, 100% 100%, 58% 96%, 18% 100%, 1% 94%, 3% 50%);
  }
  .fshape[style*='--shape:1'] {
    clip-path: polygon(2% 0%, 48% 4%, 97% 1%, 100% 38%, 97% 96%, 62% 100%, 24% 97%, 0% 100%, 2% 54%);
  }
  .fshape[style*='--shape:2'] {
    clip-path: polygon(0% 2%, 36% 0%, 100% 5%, 98% 58%, 100% 97%, 70% 100%, 30% 95%, 3% 100%, 0% 40%);
  }
  .fstep-paper .fshape {
    background: #f6f3ea;
  }
  .flow {
    isolation: isolate;
  }
  .fstep {
    isolation: isolate;
    z-index: calc(10 - var(--i));
  }
  .ftitle {
    margin: 0 0 14px;
    font-family: var(--hand);
    font-size: clamp(2.4rem, 1.6rem + 2.4vw, 3.8rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: 0;
  }
  .fnum {
    color: var(--accent);
  }
  .fme {
    margin: 0;
    font-size: var(--step-lead);
    font-weight: 600;
    line-height: 1.2;
    max-width: 22ch;
  }
  .fai {
    display: inline-flex;
    gap: 8px;
    align-items: baseline;
    flex-wrap: wrap;
    margin: 16px 0 0;
    padding: 6px 14px;
    border: 1.5px dashed currentColor;
    border-radius: 999px;
    font-size: var(--step-small);
    font-weight: 600;
  }
  .fai span {
    font-family: var(--hand);
    font-size: 1.25em;
    color: var(--accent);
  }
  .fout {
    margin: 16px 0 0;
    font-family: var(--hand);
    font-size: clamp(1.5rem, 1.2rem + 0.8vw, 2rem);
    font-weight: 600;
    line-height: 1;
  }
  .farrow {
    position: absolute;
    z-index: 2;
    width: clamp(90px, 10vw, 150px);
    right: -24%;
    bottom: 18%;
    fill: none;
    stroke: var(--amber);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .fstep:nth-child(even) .farrow {
    right: auto;
    left: -24%;
    transform: scaleX(-1);
  }
  .fstep-amber .farrow {
    stroke: #f6f3ea;
  }
  .ai-principle {
    margin: clamp(56px, 6vw, 96px) 0 0;
    padding-left: clamp(20px, 2.5vw, 40px);
    border-left: 4px solid var(--amber);
    max-width: 60ch;
  }
  .ai-principle p {
    margin: 0;
    color: #d8d6e0;
  }
  .ai-principle .ai-principle-title {
    font-size: var(--step-head);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--bg);
    margin-bottom: 16px;
  }
  .ai-link {
    margin: clamp(56px, 6vw, 96px) 0 0;
  }

  /* Playground */
  .play {
    background: var(--surface);
    margin-top: 0;
  }
  .canvas {
    height: min(88vh, 860px);
    overflow: auto;
    cursor: grab;
    scrollbar-width: none;
  }
  .canvas::-webkit-scrollbar {
    display: none;
  }
  .canvas:global(.is-dragging) {
    cursor: grabbing;
    user-select: none;
  }
  .board {
    position: relative;
    width: max(175vw, 2200px);
    height: 1300px;
  }
  .play-center {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    text-align: center;
    width: 32ch;
  }
  .play-center .lead {
    margin: 12px 0 0;
  }
  .sticky {
    position: absolute;
    background: var(--amber);
    padding: 18px 20px;
    font-size: 1.6rem;
    line-height: 1.05;
    rotate: -5deg;
    border-radius: 6px;
    margin: 0;
  }
  .pcard {
    position: absolute;
    width: 340px;
    rotate: var(--r);
    text-decoration: none;
    transition:
      rotate 0.4s var(--ease),
      translate 0.4s var(--ease);
  }
  .pcard:hover {
    rotate: 0deg;
    translate: 0 -8px;
  }
  .pcover {
    aspect-ratio: 4 / 3;
