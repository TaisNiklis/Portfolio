---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WorkSection from '../components/WorkSection.astro';
import DecisionsSection from '../components/DecisionsSection.astro';
import PlaygroundSection from '../components/PlaygroundSection.astro';
import AboutSection from '../components/AboutSection.astro';
import portrait from '../assets/portrait.jpg';
import { person, experience, introVideo } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const firstYear = Math.min(...experience.map((e) => Number(e.years.slice(0, 4))));
const years = new Date().getFullYear() - firstYear;
---

<Base
  title="Taisiia Silkina · Product designer for B2B SaaS & AI"
  description="Taisiia Silkina designs B2B SaaS and AI products: complex roles, statuses and workflows turned into clear interfaces."
>
  <!-- Hero -->
  <section class="hero wrap" aria-labelledby="hero-title">
    <p class="hello">
      Hi
      <Image src={portrait} alt="" width={160} height={160} class="hello-face" loading="eager" />
      I’m {person.first}
    </p>
    <h1 id="hero-title" class="display">
      <span class="line"><span>Product designer</span></span>
      <span class="line"><span>for B2B SaaS & AI</span></span>
    </h1>
    <p class="lead hero-sub">
      I turn messy business logic into products people understand: roles, statuses and AI features.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="#work">View work</a>
      <a class="btn btn-quiet" href={person.links.cv}>Download CV</a>
    </div>
  </section>

  <!-- Fan of cards -->
  <section class="fan wrap" aria-label="Where to start">
    <a class="card tone-blue" href="#work" style="--r:-6deg" data-reveal>
      <span class="card-title">In numbers</span>
      <span class="card-big">40+</span>
      <span class="card-text">projects in {years}+ years across web, mobile, B2B SaaS and AI.</span>
      <span class="card-go">Read the cases →</span>
    </a>
    <div class="card card-photo" style="--r:3deg" data-reveal>
      <div class="photo-drift" data-drift>
        {introVideo ? (
          <video src={`${base}/${introVideo}`} autoplay muted loop playsinline aria-label="Taisiia saying hi" />
        ) : (
          <Image
            src={portrait}
            alt="Taisiia in a pink hoodie, lifting pixel-art sunglasses and smiling"
            widths={[360, 540, 720]}
            sizes="(max-width: 760px) 70vw, 280px"
            loading="eager"
          />
        )}
      </div>
    </div>
    <a class="card tone-amber" href="#approach" style="--r:-3deg" data-reveal>
      <span class="card-title">Faster with AI</span>
      <span class="card-big">−38%</span>
      <span class="card-text">UX process and review time with my own pipeline.</span>
      <span class="card-go">See my approach →</span>
    </a>
    <a class="card tone-ink" href="#playground" style="--r:5deg" data-reveal>
      <span class="card-title">On the side</span>
      <span class="card-big">1,000+</span>
      <span class="card-text">downloads of my quiz app. Plus a pet app, games and drawings.</span>
      <span class="card-go">Go to the playground →</span>
    </a>
  </section>

  <WorkSection more />

  <DecisionsSection />

  <PlaygroundSection more />

  <AboutSection more />
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding-top: clamp(48px, 6vw, 96px);
    padding-bottom: clamp(72px, 8vw, 128px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hello {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.22em;
    font-size: var(--step-display);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.05em;
    margin: 0 0 0.12em;
    animation: fade 0.8s var(--ease) both;
  }
  .hello :global(.hello-face) {
    width: 0.82em;
    height: 0.82em;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .display {
    font-size: var(--step-display);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.05em;
    margin: 0;
  }
  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }
  .line > span {
    display: block;
    animation: rise 0.9s var(--ease) both;
  }
  .line:nth-child(2) > span {
    animation-delay: 0.11s;
  }
  @keyframes rise {
    from {
      transform: translateY(105%);
    }
  }
  .hero-sub {
    max-width: 46ch;
    color: var(--muted);
    margin: 32px 0 0;
    animation: fade 0.8s 0.35s var(--ease) both;
  }
  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 32px;
    animation: fade 0.8s 0.45s var(--ease) both;
  }
  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  /* Fan */
  .fan {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding-bottom: calc(var(--gap-section) / 2);
  }
  .card {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    padding: clamp(20px, 2vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-decoration: none;
    rotate: var(--r);
    margin-inline: -12px;
    transition:
      rotate 0.4s var(--ease),
      translate 0.4s var(--ease);
  }
  .card:hover,
  .card:focus-visible {
    rotate: 0deg;
    translate: 0 -10px;
    z-index: 2;
  }
  .card-title {
    font-size: var(--step-lead);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .card-text {
    font-size: var(--step-body);
    line-height: 1.4;
  }
  .card-go {
    margin-top: auto;
    font-weight: 600;
  }
  .card-photo {
    padding: 0;
    overflow: hidden;
    position: relative;
  }
  .photo-drift {
    height: 112%;
    margin-top: -6%;
    transform: translateY(var(--drift, 0));
  }
  .card-big {
    margin: 0;
    font-size: var(--step-sub);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.95;
  }
  .card-photo :global(img),
  .card-photo video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  @media (max-width: 1000px) {
    .fan {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }
    .card {
      margin-inline: 0;
      rotate: calc(var(--r) * 0.35);
    }
  }
  @media (max-width: 760px) {
    .hero {
      padding-top: 24px;
      padding-bottom: 56px;
    }
    .fan {
      gap: 16px;
    }
    .card {
      aspect-ratio: 3 / 4;
      padding: 16px;
    }
  }
</style>
