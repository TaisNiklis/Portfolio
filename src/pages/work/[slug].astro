---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((c) => ({ params: { slug: c.data.slug }, props: { entry: c } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
// Long titles carry a subtitle after the colon; the h1 keeps the first part.
const [headline, ...rest] = d.title.split(': ');
const subtitle = rest.join(': ');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const meta = [
  ['Product', d.product],
  ['My role', d.role],
  ['Team', d.team],
  ['Timeline', d.timeline],
  ['Platform', d.platform],
];
---

<Base title={`${d.title} · Taisiia Silkina`} description={d.summary}>
  <article class="case">
    <header class="wrap col case-head">
      <a class="link-arrow back" href={`${base}/#work`}><span aria-hidden="true">←</span> All work</a>
      <h1 class="case-title">{headline}</h1>
      {subtitle && <p class="case-subtitle">{subtitle.charAt(0).toUpperCase() + subtitle.slice(1)}</p>}
      <p class="lead case-sum">{d.summary}</p>
      <dl class="case-metrics">
        {d.metrics.map((m) => (
          <div>
            <dt>{m.label} <span class="src">({m.source})</span></dt>
            <dd>{m.value}</dd>
          </div>
        ))}
      </dl>
      <dl class="case-meta">
        {meta.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
    </header>
    <div class="wrap col">
      <div class="prose">
        <Content components={{ Figure }} />
      </div>
    </div>
  </article>
</Base>

<style>
  .case-head {
    padding-top: clamp(32px, 5vw, 72px);
    padding-bottom: clamp(48px, 6vw, 96px);
  }
  .back {
    text-decoration: none;
  }
  .back:hover span {
    transform: translateX(-4px);
  }
  .case-title {
    font-size: clamp(1.625rem, 0.9rem + 4vw, 4.25rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.98;
    margin: 32px 0 16px;
    text-wrap: balance;
  }
  .col {
    max-width: calc(820px + 2 * var(--margin));
  }
  .case-subtitle {
    font-size: var(--step-lead);
    font-weight: 600;
    margin: 0 0 24px;
    color: var(--muted);
  }
  .case-sum {
    max-width: 52ch;
    margin: 0;
  }
  .case-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: clamp(40px, 5vw, 72px) 0 0;
  }
  .case-metrics div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    background: var(--surface);
    border-radius: var(--radius);
    padding: 24px;
  }
  .case-metrics dd {
    margin: 0;
    font-size: var(--step-head);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--accent);
    line-height: 1;
  }
  .case-metrics dt {
    margin-top: 10px;
    font-size: var(--step-small);
  }
  .src {
    color: var(--muted);
  }
  .case-meta {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 40px 0 0;
    font-size: var(--step-small);
  }
  .case-meta dt {
    font-weight: 600;
    margin-bottom: 4px;
  }
  .case-meta dd {
    margin: 0;
    color: var(--muted);
  }
  .prose {
    max-width: 100%;
  }
  .prose :global(h2) {
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin: 88px 0 20px;
  }
  .prose :global(h3) {
    font-size: var(--step-lead);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 48px 0 12px;
  }
  .prose :global(p),
  .prose :global(li) {
    max-width: 66ch;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.2em;
  }
  .prose :global(li) {
    margin-bottom: 8px;
  }
  .prose :global(blockquote) {
    margin: 40px 0;
    padding: 24px 28px;
    background: var(--surface);
    border-radius: var(--radius);
    font-size: var(--step-lead);
    line-height: 1.35;
  }
  .prose :global(blockquote p) {
    margin: 0;
  }
  @media (max-width: 900px) {
    .case-metrics,
    .case-meta {
      grid-template-columns: 1fr;
    }
  }
</style>
