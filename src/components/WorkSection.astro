---
import WorkVisual from './WorkVisual.astro';
import ArrowUpRight from './ArrowUpRight.astro';
import { work } from '../data/site';

interface Props {
  /** h1 on the Work page, h2 on the home page */
  as?: 'h1' | 'h2';
  /** show the link to the Work page */
  more?: boolean;
}
const { as: H = 'h2', more = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="work" class="section wrap" aria-labelledby="work-title">
  <div class="sec-head" data-reveal>
    <H id="work-title" class="h2">
      {more ? (
        <a class="head-link" href={`${base}/work/`}>Selected work <ArrowUpRight /></a>
      ) : (
        'Selected work'
      )}
    </H>
    <div class="sec-sub">
      <p class="lead">B2B SaaS and AI products, from discovery to developer handoff.</p>
    </div>
  </div>
  <ol class="timeline">
    {work.map((w, i) => {
      const href = 'slug' in w && w.slug ? `${base}/work/${w.slug}/` : 'href' in w ? w.href : null;
      const Tag = href ? 'a' : 'div';
      return (
        <li class="item" style={`--i:${i}`} data-stack>
          <Tag class="item-body" href={href ?? undefined}>
            <h3 class="h3" data-reveal>{w.title}</h3>
            <div class="info">
              <p class="facts" data-reveal style="--i:1">
                {w.facts.map((f, j) => (
                  <span class:list={['fact', { role: j === 0 }]}>{f}</span>
                ))}
              </p>
              <ul class="highlights" data-reveal style="--i:2">
                {w.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
              <p class="item-go" data-reveal style="--i:4">
                {href ? (
                  <span class="link-arrow">Read the case study <span aria-hidden="true">→</span></span>
                ) : (
                  <span class="soon">Case study in progress</span>
                )}
              </p>
            </div>
            <div class="visual" data-reveal style="--i:3">
              <WorkVisual kind={w.visual} />
            </div>
          </Tag>
        </li>
      );
    })}
  </ol>
</section>

<style>
  /* Work */
  /* Work cards stack: each card sticks under the header and the next one slides over it. */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(32px, 4vw, 56px);
  }
  .item {
    position: sticky;
    top: calc(96px + var(--i) * 18px);
    display: block;
    padding: clamp(24px, 3vw, 48px);
    background: var(--surface);
    border-radius: calc(var(--radius) + 8px);
    transform-origin: 50% 0;
    scale: var(--s, 1);
    filter: brightness(var(--b, 1));
    box-shadow: 0 -12px 40px rgb(14 12 21 / 0.06); /* taste-skill-ignore: edge of the card sliding over */
  }
  .item-body {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 24px 48px;
    text-decoration: none;
    align-items: start;
  }
  .item-body > .h3 {
    grid-column: 1 / -1;
    font-size: var(--step-sub);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .info {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-self: stretch;
  }
  /* What a recruiter scans first: role, domain, platform, year */
  .facts {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
  }
  .fact + .fact::before {
    content: '·';
    margin: 0 0.5em;
    color: var(--muted);
  }
  .fact.role {
    font-weight: 600;
  }
  .highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .highlights li {
    position: relative;
    padding-left: 1.4em;
    line-height: 1.4;
  }
  .highlights li::before {
    content: '';
    position: absolute;
    left: 0.15em;
    top: 0.45em;
    width: 0.55em;
    height: 0.3em;
    border-left: 2px solid var(--accent); /* taste-skill-ignore: tick mark, not a divider */
    border-bottom: 2px solid var(--accent); /* taste-skill-ignore: tick mark, not a divider */
    rotate: -45deg;
  }
  .item-go {
    margin: auto 0 0;
    padding-top: 8px;
    color: var(--accent);
  }
  .soon {
    color: var(--muted);
    font-weight: 600;
  }

  @media (max-width: 1000px) {
    .item {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .item-body {
      grid-template-columns: 1fr;
    }
    .visual {
      order: 3;
    }
  }
  @media (max-width: 760px) {
    .item {
      position: relative;
      top: auto;
      scale: none;
      filter: none;
      box-shadow: none; /* taste-skill-ignore: removes the stack shadow */
    }
  }
</style>
