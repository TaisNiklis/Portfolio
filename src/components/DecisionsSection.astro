---
import { decisions, aiNote, person } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!-- Decisions behind the work: three calls from real projects, each with the problem and what it changed. -->
<section id="approach" class="decisions" aria-labelledby="decisions-title">
  <div class="wrap section">
    <div class="sec-head" data-reveal>
      <h2 id="decisions-title" class="h2">Decisions behind the work</h2>
      <div class="sec-sub">
        <p class="lead">What I decided, why, and what it changed. Each one comes from a real project.</p>
      </div>
    </div>
    <ol class="cards">
      {decisions.map((d, i) => (
        <li class="card" data-reveal style={`--i:${i}`}>
          <p class="value">
            <span class="num">{d.value}</span>
            <span class="num-label">{d.valueLabel}</span>
          </p>
          <h3 class="title">{d.title}</h3>
          <p class="problem">{d.problem}</p>
          <p class="call">{d.call}</p>
          <a class="link-arrow from" href={`${base}/work/${d.slug}/`}>
            {d.from} <span aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
    <div class="ai-note" data-reveal>
      <p>{aiNote}</p>
      <a class="link-arrow" href={person.links.skills}>My Claude skills on GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<style>
  .decisions {
    background: var(--ink);
    color: var(--bg);
  }
  .decisions .sec-sub .lead {
    color: #d8d6e0;
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(24px, 2.6vw, 40px);
    border-radius: calc(var(--radius) + 8px);
    background: #1b1924;
  }
  .value {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0 0 16px;
  }
  .num {
    font-size: var(--step-sub);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--amber);
  }
  .num-label,
  .problem {
    color: #d8d6e0;
  }
  .title {
    margin: 0;
    font-size: var(--step-lead);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .problem,
  .call {
    margin: 0;
  }
  .from {
    align-self: flex-start;
    margin-top: auto;
    padding-top: 16px;
    font-weight: 600;
  }
  .ai-note {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px 48px;
    margin-top: clamp(48px, 6vw, 80px);
    padding: clamp(24px, 2.6vw, 40px);
    border-radius: calc(var(--radius) + 8px);
    background: var(--amber);
    color: var(--ink);
  }
  .ai-note p {
    margin: 0;
    max-width: 62ch;
    font-weight: 600;
  }
  .ai-note .link-arrow {
    font-weight: 600;
  }
  @media (max-width: 1000px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
