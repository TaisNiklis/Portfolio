---
import { person } from '../data/site';

// Stickers piled at the bottom of the card: pills with words and round icons.
// x / y are % of the pile, size and rotation in em / deg, so the pile scales with the card.
type Sticker =
  | { kind: 'pill'; text: string; tone: string; x: number; y: number; r: number; w: number }
  | { kind: 'dot'; icon: 'smile' | 'mail' | 'chat' | 'globe'; tone: string; x: number; y: number; r: number };
const stickers: Sticker[] = [
  { kind: 'dot', icon: 'smile', tone: 'blue', x: 0, y: 8, r: -8 },
  { kind: 'pill', text: 'say hi', tone: 'ink', x: 5, y: 48, r: 32, w: 13 },
  { kind: 'dot', icon: 'chat', tone: 'amber', x: 15, y: 2, r: 10 },
  { kind: 'dot', icon: 'smile', tone: 'ink', x: 13, y: 70, r: 6 },
  { kind: 'pill', text: 'let’s talk', tone: 'blue', x: 23, y: 26, r: -6, w: 15 },
  { kind: 'dot', icon: 'mail', tone: 'ink', x: 26, y: 72, r: -10 },
  { kind: 'pill', text: 'open to work', tone: 'amber', x: 35, y: 52, r: 4, w: 19 },
  { kind: 'dot', icon: 'globe', tone: 'blue', x: 43, y: 6, r: 0 },
  { kind: 'dot', icon: 'smile', tone: 'amber', x: 55, y: 18, r: -12 },
  { kind: 'pill', text: 'remote', tone: 'ink', x: 58, y: 56, r: -14, w: 13 },
  { kind: 'pill', text: 'B2B SaaS & AI', tone: 'blue', x: 66, y: 20, r: 18, w: 19 },
  { kind: 'dot', icon: 'mail', tone: 'amber', x: 72, y: 68, r: 8 },
  { kind: 'dot', icon: 'chat', tone: 'blue', x: 84, y: 54, r: -6 },
  { kind: 'dot', icon: 'smile', tone: 'ink', x: 89, y: 8, r: 12 },
];
---

<!-- Closing call to action, shown above the footer on every page -->
<section class="wrap cta-wrap" aria-labelledby="cta-title">
  <div class="cta">
    <div class="cta-copyblock">
      <div class="cta-pitch">
        <h2 id="cta-title" class="cta-title">Looking for a designer who takes ownership?</h2>
        <p class="cta-text">
          I’d love to join a product-driven, collaborative team that values thoughtful design, open communication and
          growth. I like solving complex UX challenges and owning solutions that work for both users and the business.
        </p>
      </div>
      <div class="cta-contact">
      <div class="cta-email-row">
        <a class="cta-email" href={`mailto:${person.email}?subject=Hi%20Taisiia`}>{person.email}</a>
        <button class="cta-copy" type="button" data-copy={person.email} aria-label="Copy email address">
          <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
            <rect x="8" y="8" width="12" height="12" rx="2.5" fill="none" stroke="currentColor" stroke-width="2"></rect>
            <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" fill="none" stroke="currentColor" stroke-width="2"></path>
          </svg>
          <span class="cta-copied" data-copy-label aria-live="polite"></span>
        </button>
      </div>
      <ul class="cta-links">
        <li><a class="link-arrow" href={person.links.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a></li>
        <li><a class="link-arrow" href={person.links.cv}>CV <span aria-hidden="true">↗</span></a></li>
        <li><a class="link-arrow" href={person.links.behance}>Behance <span aria-hidden="true">↗</span></a></li>
      </ul>
      </div>
    </div>

    <div class="pile" aria-hidden="true">
      {stickers.map((s, i) =>
        s.kind === 'pill' ? (
          <span class={`st pill t-${s.tone}`} style={`--x:${s.x}%;--y:${s.y}%;--r:${s.r}deg;--w:${s.w}em;--i:${i}`}>
            <span class="pill-text">{s.text}</span>
          </span>
        ) : (
          <span class={`st dot t-${s.tone}`} style={`--x:${s.x}%;--y:${s.y}%;--r:${s.r}deg;--i:${i}`}>
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
              {s.icon === 'smile' && (
                <>
                  <path d="M14 27c2.5 5 6 7.5 10 7.5s7.5-2.5 10-7.5" />
                  <circle cx="18" cy="18" r="1.5" fill="currentColor" />
                  <circle cx="30" cy="18" r="1.5" fill="currentColor" />
                </>
              )}
              {s.icon === 'mail' && (
                <>
                  <rect x="10" y="14" width="28" height="20" rx="2" />
                  <path d="M10 16l14 11 14-11" />
                </>
              )}
              {s.icon === 'chat' && (
                <>
                  <path d="M12 14h24a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H22l-7 6v-6h-3a3 3 0 0 1-3-3V17a3 3 0 0 1 3-3z" />
                  <path d="M17 21h14M17 26h9" />
                </>
              )}
              {s.icon === 'globe' && (
                <>
                  <circle cx="24" cy="24" r="13" />
                  <path d="M11 24h26M24 11c4 4 5.5 8.5 5.5 13S28 33 24 37c-4-4-5.5-8.5-5.5-13S20 15 24 11z" />
                </>
              )}
            </svg>
          </span>
        ),
      )}
    </div>
  </div>
</section>

<style>
  .cta-wrap {
    padding-block: calc(var(--gap-section) / 2) 0;
  }
  .cta {
    position: relative;
    overflow: hidden;
    border-radius: calc(var(--radius) + 8px);
    background: var(--surface);
    color: var(--ink);
    padding: clamp(40px, 4vw, 56px) clamp(20px, 4vw, 56px) 0;
  }
  /* Light card: pitch on the left, email and links on the right (Figma: Sticker/CTA, Tone=Light) */
  .cta-copyblock {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 32px 48px;
  }
  .cta-pitch {
    flex: 0 1 680px;
  }
  .cta-contact {
    flex: 0 0 auto;
  }
  .cta-title {
    margin: 0;
    max-width: 18ch;
    font-size: var(--step-head);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    text-wrap: balance;
  }
  .cta-text {
    margin: 20px 0 0;
    max-width: 58ch;
  }
  .cta-email-row {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 0;
  }
  .cta-email {
    font-size: clamp(1.25rem, 0.9rem + 1.8vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .cta-email:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .cta-copy {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--ink);
    cursor: pointer;
    transition: background-color 0.2s var(--ease);
  }
  .cta-copy:hover {
    background: rgb(14 12 21 / 0.08);
  }
  .cta-copied {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 4px);
    translate: -50% 0;
    font-size: var(--step-small);
    font-weight: 600;
    white-space: nowrap;
  }
  .cta-links {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px clamp(20px, 3vw, 40px);
    font-size: var(--step-lead);
    font-weight: 600;
  }

  /* Sticker pile */
  .pile {
    position: relative;
    height: clamp(220px, 26vw, 360px);
    margin: clamp(32px, 4vw, 56px) clamp(-56px, -4vw, -20px) 0;
    font-size: clamp(10px, 1.35vw, 20px);
  }
  .st {
    position: absolute;
    left: var(--x);
    top: var(--y);
    rotate: var(--r);
    display: grid;
    place-items: center;
    font-weight: 600;
    letter-spacing: -0.03em;
    transition: rotate 0.4s var(--ease), translate 0.4s var(--ease);
  }
  .st:hover {
    rotate: calc(var(--r) * -1);
    translate: 0 -6px;
  }
  .pill {
    width: var(--w);
    height: 4.6em;
    border-radius: 999px;
    line-height: 1;
    white-space: nowrap;
  }
  .pill-text {
    font-size: 1.8em;
  }
  .dot {
    width: 6.2em;
    height: 6.2em;
    border-radius: 50%;
  }
  .dot svg {
    width: 62%;
    height: 62%;
  }
  .t-blue {
    background: var(--accent);
    color: #fff;
  }
  .t-ink {
    background: var(--ink);
    color: var(--bg);
  }
  .t-amber {
    background: var(--amber);
    color: var(--ink);
  }
  /* The pile drops in when the card enters (site.ts adds .is-in) */
  :global(.js) .pile .st {
    opacity: 0;
    translate: 0 -40px;
  }
  :global(.js) .pile:global(.is-in) .st {
    opacity: 1;
    translate: 0 0;
    transition:
      opacity 0.4s var(--ease) calc(var(--i) * 45ms),
      translate 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) calc(var(--i) * 45ms),
      rotate 0.4s var(--ease);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .pile .st {
      opacity: 1;
      translate: none;
    }
  }
</style>
