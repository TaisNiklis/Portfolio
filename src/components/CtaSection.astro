---
import { person } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const statement =
  'If you are building a B2B SaaS or AI product and need a designer who turns complex logic into clear interfaces, let’s talk.';
const words = statement.split(' ');
---

<!-- Closing call to action, shown above the footer on every page -->
<section class="wrap cta-wrap" aria-labelledby="cta-title">
  <div class="cta">
    <div class="cta-pitch">
      <p class="cta-label">Get in touch</p>
      <h2 id="cta-title" class="cta-statement" data-fill style={`--n:${words.length}`}>
        {words.map((w, i) => (
          <span class="w" style={`--i:${i}`}>{w} </span>
        ))}
      </h2>
    </div>
    <div class="cta-contact">
      <a class="cta-email" href={`mailto:${person.email}?subject=Hi%20Taisiia`}>{person.email}</a>
      <button class="cta-copy" type="button" data-copy={person.email}>
        <span data-copy-label>Copy email</span>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
          <rect x="8" y="8" width="12" height="12" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8"></rect>
          <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" fill="none" stroke="currentColor" stroke-width="1.8"></path>
        </svg>
      </button>
      <ul class="cta-links">
        <li><a class="link-arrow" href={person.links.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a></li>
        <li><a class="link-arrow" href={person.links.cv}>CV <span aria-hidden="true">↗</span></a></li>
        <li><a class="link-arrow" href={person.links.behance}>Behance <span aria-hidden="true">↗</span></a></li>
      </ul>
      <div class="cta-more">
        <p>Prefer to look around first?</p>
        <a class="link-arrow" href={`${base}/work/`}>See the case studies <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-wrap {
    padding-block: calc(var(--gap-section) / 2) 0;
  }
  .cta {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 48px clamp(48px, 8vw, 160px);
    padding: clamp(40px, 5vw, 80px) clamp(24px, 4vw, 56px);
    border-radius: calc(var(--radius) + 8px);
    background: var(--surface);
  }
  .cta-label {
    margin: 0 0 24px;
    color: var(--muted);
  }
  /* The statement fills in word by word as it scrolls into view (site.ts sets --p from 0 to 1).
     Without script or with reduced motion it stays fully dark. */
  .cta-statement {
    margin: 0;
    max-width: 20ch;
    font-size: var(--step-sub);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }
  :global(.js) .cta-statement .w {
    --k: clamp(0, var(--p, 1) * var(--n) - var(--i), 1);
    color: color-mix(in srgb, var(--ink) calc(22% + 78% * var(--k)), var(--surface));
    transition: color 0.3s linear;
  }
  .cta-contact {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-self: start;
  }
  .cta-email {
    font-size: var(--step-lead);
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .cta-email:hover {
    color: var(--accent);
  }
  .cta-copy {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    align-self: flex-start;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
  }
  .cta-copy:hover {
    color: var(--accent);
  }
  .cta-links {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    font-weight: 600;
  }
  .cta-more {
    margin-top: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--surface-2); /* taste-skill-ignore: divider from the agreed CTA layout */
  }
  .cta-more p {
    margin: 0 0 8px;
    color: var(--muted);
  }
  .cta-more .link-arrow {
    font-weight: 600;
    color: var(--accent);
  }
  @media (max-width: 1000px) {
    .cta {
      grid-template-columns: 1fr;
    }
  }
</style>
