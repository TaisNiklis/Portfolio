---
import Base from '../layouts/Base.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
}
const { title, description, updated } = Astro.props;
---

<Base title={`${title} · Taisiia Silkina`} description={description}>
  <article class="wrap legal">
    <h1 class="h2">{title}</h1>
    <p class="updated">Last updated: {updated}</p>
    <div class="legal-body">
      <slot />
    </div>
  </article>
</Base>

<style>
  .legal {
    padding-block: clamp(48px, 7vw, 112px) 0;
  }
  .legal > .h2,
  .updated,
  .legal-body {
    max-width: 68ch;
  }
  .updated {
    margin: 16px 0 clamp(32px, 4vw, 56px);
    color: var(--muted);
  }
  .legal-body :global(h2) {
    margin: 48px 0 12px;
    font-size: var(--step-lead);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .legal-body :global(p),
  .legal-body :global(ul) {
    margin: 0 0 16px;
  }
  .legal-body :global(ul) {
    padding-left: 1.2em;
    list-style: disc;
  }
  .legal-body :global(li + li) {
    margin-top: 6px;
  }
  .legal-body :global(a) {
    color: var(--accent);
  }
</style>
